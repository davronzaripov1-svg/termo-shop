# Пример файла переменных окружения для TermoStick
# Скопируйте этот файл в .env и заполните значения

# Домен приложения
VITE_APP_URL=https://termostick.uz

# API endpoints (если будет бэкенд)
VITE_API_URL=https://api.termostick.uz

# Контактная информация
VITE_CONTACT_EMAIL=info@termostick.uz
VITE_CONTACT_PHONE=+998901234567

# Социальные сети
VITE_TELEGRAM=https://t.me/termostick
VITE_INSTAGRAM=https://instagram.com/termostick
VITE_FACEBOOK=https://facebook.com/termostick

# Google Analytics (опционально)
VITE_GA_TRACKING_ID=

# Yandex Metrika (опционально)
VITE_YM_TRACKING_ID=

# Режим разработки
NODE_ENV=production